      },
      "enrollment": {
        "path": "audio/hindi-02-enrollment.wav",
        "text": "उतना पढ़ाई का उतनी पढ़ाई मे गुणवत्ता नही है जितनी अन्य जो कॉलेज वगैरा मे है",
        "source_file": "5348024557637377_chunk_5_enhanced.wav",
